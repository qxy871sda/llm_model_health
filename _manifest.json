{
  "manifest_version": 2,
  "version": "1.2.0",
  "name": "LLM 模型健康度/成功率统计",
  "description": "统计并展示 MaiBot 使用的 LLM 模型健康度：窗口内请求成功率（成功取自宿主 llm_usage、失败取自宿主 WARNING 日志）、按需开启的失败原因与模型自身耗时，以及可选的历史请求数、token 用量与费用汇总。",
  "author": {
    "name": "qxy871sda",
    "url": "https://github.com/qxy871sda"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/qxy871sda/llm_model_health",
    "homepage": "https://github.com/qxy871sda/llm_model_health",
    "documentation": "https://github.com/qxy871sda/llm_model_health/blob/main/README.md",
    "issues": "https://github.com/qxy871sda/llm_model_health/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.forward",
    "config.get",
    "database.query",
    "statistics.local.models"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "qxy871sda.llm_model_health"
}
